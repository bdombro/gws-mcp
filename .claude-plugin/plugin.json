{
  "name": "google-gws-mcp",
  "version": "1.0.1",
  "description": "Call any Google Workspace API (Gmail, Calendar, Drive, Docs, Sheets, People, Tasks…) through the gws CLI over MCP.",
  "author": {
    "name": "Brian Dombrowski"
  },
  "homepage": "https://github.com/bdombro/google-gws-mcp",
  "repository": "https://github.com/bdombro/google-gws-mcp",
  "mcpServers": {
    "google-gws-mcp": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/dist/google-gws-mcp.mjs", "mcp"]
    }
  }
}
